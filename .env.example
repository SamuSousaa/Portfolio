# Briefings (/briefing/[slug]). Copie para .env.local e preencha; na Vercel, cadastre as mesmas
# em Settings → Environment Variables. Nenhuma leva NEXT_PUBLIC_: ficam só no servidor.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# chave "service_role" (ou a "secret key" nova, sb_secret_...). Ignora o RLS: nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=

# Resend → API Keys
RESEND_API_KEY=
# para onde vai o aviso de cada envio
BRIEFING_EMAIL_TO=
# opcional: remetente num domínio verificado no Resend. Sem ela, usa onboarding@resend.dev,
# que só entrega no e-mail da própria conta do Resend.
BRIEFING_EMAIL_FROM="Briefing <briefing@samuelsousadev.com.br>"
